# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Required: random string to sign sessions (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-something-random

# ── Google Sign In ──────────────────────────────────────────────────────────
# Get these from: https://console.cloud.google.com
#   1. Create a project (or pick an existing one)
#   2. APIs & Services → Credentials → Create Credentials → OAuth 2.0 Client ID
#   3. Application type: Web application
#   4. Authorized redirect URI: http://localhost:3000/auth/google/callback
#      (add your phone's local IP too, e.g. http://192.168.1.x:3000/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Allowed emails (optional) ───────────────────────────────────────────────
# Comma-separated list. If blank, ANY Google account can log in.
ALLOWED_EMAILS=your@email.com,partner@email.com

# ── App URL (change if not running on localhost:3000) ───────────────────────
APP_URL=http://localhost:3000

# ── Apple Sign In (optional — requires HTTPS + Apple Developer account) ─────
# NOTE: Apple requires the callback URL to be HTTPS. Won't work on plain HTTP.
# Setup: https://developer.apple.com/sign-in-with-apple/
#   APP_URL must be your HTTPS domain (e.g. https://yournotes.example.com)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
